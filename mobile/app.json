{
  "expo": {
    "name": "Metatake",
    "slug": "metatake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metatake",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.metatake.app",
      "associatedDomains": [
        "applinks:metatake.net"
      ],
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used only to show filming locations near you on the Locations map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.metatake.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "metatake.net",
              "pathPrefix": "/film"
            },
            {
              "scheme": "https",
              "host": "metatake.net",
              "pathPrefix": "/director"
            },
            {
              "scheme": "https",
              "host": "metatake.net",
              "pathPrefix": "/what-to-watch"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only to show filming locations near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "primaryColor": "#E61E4D",
    "backgroundColor": "#FFFFFF"
  }
}