{
  "expo": {
    "name": "Metatake",
    "slug": "wonwoometatake",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metatake",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/ios-icon-light.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "bundleIdentifier": "net.metatake.app",
      "associatedDomains": [
        "applinks:metatake.net"
      ],
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used only to show filming locations near you on the Locations map.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.metatake.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "metatake.net",
              "pathPrefix": "/film"
            },
            {
              "scheme": "https",
              "host": "metatake.net",
              "pathPrefix": "/director"
            },
            {
              "scheme": "https",
              "host": "metatake.net",
              "pathPrefix": "/what-to-watch"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#111111"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-web-browser",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E3120B"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only to show filming locations near you."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "allowBackup": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "primaryColor": "#E61E4D",
    "backgroundColor": "#FFFFFF",
    "extra": {
      "eas": {
        "projectId": "5f5d3978-00e0-4e1b-8111-6618fac80f12"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/5f5d3978-00e0-4e1b-8111-6618fac80f12"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "wonwoometatakes-team"
  }
}
