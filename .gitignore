# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
worker/node_modules/
worker/dist/

# worker run logs + enrichment output bundles (artifacts, not source)
*.log
worker/figure-enrich*.json

.fuse_hidden*
.autodeploy.log
.autodeploy.out.log
.autodeploy.err.log

# figure_seo 파이프라인 대용량 산출물
outputs/figure_seo/*.jsonl

# Search Console service-account key (worker/gsc-pull.py) — never commit
worker/gsc-sa.json
worker/.gsc-watch.pid
worker/gsc-pull.log

# CRM — Gmail OAuth client secret (worker/gmail-auth.py) — never commit
worker/client_secret*.json
worker/*oauth*.json
worker/gmail-*.json
worker/.crm-scout.lock

# CRM — generated import data (contains personal contact emails) — never commit
crm-handoff/contacts.json
crm-handoff/_batches/
data/i18n/src/

# mobile app (Expo)
# No trailing slash: with one, the pattern matches a DIRECTORY only, and a
# node_modules SYMLINK (what a git worktree needs to reuse the real install)
# sails straight past it into a commit — pointing at an absolute path on one
# machine, which is a dangling link in every checkout that is not that machine.
mobile/node_modules
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/ios/
mobile/android/

# DMARC aggregate reports (Google/others) — keep out of repo
*!metatake.net!*.zip
*!metatake.net!*.xml

# Owner's working material — essay drafts, .docx notes, a streaming-services CSV.
# NOT code, and this repo is PUBLIC. 극상글/ in particular holds the generators for
# the Strong Misreadings column (Ultra_Creative_Misreading_PROMPT.md and the
# 압축오독 prompt) — publishing those publishes the method itself, on a repo with
# none of the robots.txt protection metatake.net gives the same writing.
#
# These were committed once by accident (6e2000b4, 2026-07-19, swept into the EAS
# signing commit by a broad `git add`) and untracked the next day (0fb34f8f).
# Ignored here so that cannot happen a third time.
/극상글/
/병치/
/세계 영화/

# Korean localization: English extracts are regenerable from the DB
# (worker/i18n-extract.py). Translations in data/i18n/out ARE committed.
data/i18n/src2/
