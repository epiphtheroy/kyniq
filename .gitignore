# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
worker/node_modules/
worker/dist/

# worker run logs + enrichment output bundles (artifacts, not source)
*.log
worker/figure-enrich*.json

.fuse_hidden*
.autodeploy.log
.autodeploy.out.log
.autodeploy.err.log

# figure_seo 파이프라인 대용량 산출물
outputs/figure_seo/*.jsonl

# Search Console service-account key (worker/gsc-pull.py) — never commit
worker/gsc-sa.json
worker/.gsc-watch.pid
worker/gsc-pull.log

# CRM — Gmail OAuth client secret (worker/gmail-auth.py) — never commit
worker/client_secret*.json
worker/*oauth*.json
worker/gmail-*.json
worker/.crm-scout.lock

# CRM — generated import data (contains personal contact emails) — never commit
crm-handoff/contacts.json
crm-handoff/_batches/
