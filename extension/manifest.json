{
  "manifest_version": 3,
  "name": "Metatake TakeScore — film criticism overlay",
  "version": "1.0.0",
  "description": "See Metatake's TakeScore and critical read on any film — right on Letterboxd, IMDb, TMDB, Wikipedia and Rotten Tomatoes.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
    "default_title": "Metatake TakeScore"
  },
  "host_permissions": ["https://metatake.net/*"],
  "content_scripts": [
    {
      "matches": [
        "https://letterboxd.com/film/*",
        "https://www.imdb.com/title/*",
        "https://www.themoviedb.org/movie/*",
        "https://en.wikipedia.org/wiki/*",
        "https://www.rottentomatoes.com/m/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
