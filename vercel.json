{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "headers": [
    {
      "source": "/geo/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "access-control-allow-origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/metrics/insights",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/crm/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/connect/sync-cron",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/push/availability-cron",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/gsc/cron",
      "schedule": "0 10 * * *"
    }
  ]
}
