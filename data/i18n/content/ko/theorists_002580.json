nce", "field": "name", "lang": "ko", "text": "마이클 스펜스"}, {"entity_type": "theorist", "entity_key": "jerald-greenberg", "field": "name", "lang": "ko", "text": "제럴드 그린버그"}, {"entity_type": "theorist", "entity_key": "everett-rogers", "field": "name", "lang": "ko", "text": "에버렛 로저스"}, {"entity_type": "theorist", "entity_key": "oliver-williamson", "field": "name", "lang": "ko", "text": "올리버 윌리엄슨"}, {"entity_type": "theorist", "entity_key": "chris-argyris", "field": "name", "lang": "ko", "text": "크리스 아지리스"}, {"entity_type": "theorist", "entity_key": "john-kotter", "field": "name", "lang": "ko", "text": "존 코터"}, {"entity_type": "theorist", "entity_key": "bill-george", "field": "name", "lang": "ko", "text": "빌 조지"}, {"entity_type": "theorist", "entity_key": "george-homans", "field": "name", "lang": "ko", "text": "조지 호먼스"}, {"entity_type": "theorist", "entity_key": "david-cooperrider", "field": "name", "lang": "ko", "text": "데이비드 쿠퍼라이더"}, {"entity_type": "theorist", "entity_key": "robert-bies", "field": "name", "lang": "ko", "text": "로버트 바이스"}, {"entity_type": "theorist", "entity_key": "patrick-wright", "field": "name", "lang": "ko", "text": "패트릭 라이트"}, {"entity_type": "theorist", "entity_key": "gary-mcmahan", "field": "name", "lang": "ko", "text": "게리 맥마한"}, {"entity_type": "theorist", "entity_key": "philip-kotler", "field": "name", "lang": "ko", "text": "필립 코틀러"}, {"entity_type": "theorist", "entity_key": "jan-johanson", "field": "name", "lang": "ko", "text": "얀 요한손"}, {"entity_type": "theorist", "entity_key": "mark-kramer", "field": "name", "lang": "ko", "text": "마크 크레이머"}, {"entity_type": "theorist", "entity_key": "arnold-bakker", "field": "name", "lang": "ko", "text": "아르놀트 바커"}, {"entity_type": "theorist", "entity_key": "evangelia-demerouti", "field": "name", "lang": "ko", "text": "에방겔리아 데메루티"}, {"entity_type": "theorist", "entity_key": "john-french", "field": "name", "lang": "ko", "text": "존 프렌치"}, {"entity_type": "theorist", "entity_key": "bertram-raven", "field": "n