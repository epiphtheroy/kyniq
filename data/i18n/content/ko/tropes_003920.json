ity_type": "trope", "entity_key": "the-marionette-and-its-hidden-hand", "field": "title", "lang": "ko", "text": "꼭두각시와 그 숨은 손"}, {"entity_type": "trope", "entity_key": "the-marionette-and-its-hidden-hand", "field": "laconic", "lang": "ko", "text": "인형이 그 뒤에서 줄을 당기는 보이지 않는 손을 드러낸다."}]