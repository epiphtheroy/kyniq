  "field": "laconic",
  "lang": "ko",
  "text": "범죄를 본 자들. 말하지 못하거나, 말하지 않는다.",
  "model": "claude-opus-5",
  "source_sha256": "747063c523ae12992b79f299ae5f01179d03287d96d2e361c06e4ed1a629c51f"
 },
 {
