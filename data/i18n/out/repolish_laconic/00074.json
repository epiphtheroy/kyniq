  "source_sha256": "f5075f1fde9c13424157ca8b8894a3ae0c281654cb1f276d7c798f788762825d"
 },
 {
  "entity_type": "trope",
  "entity_key": "the-woman-erased-where-desire-has-no-frame",
  "field": "laconic",
  "lang": "ko",
  "text": "영화의 셈법에 그녀의 욕망을 놓을 자리가 없다. 그래서 그녀는 증발한다.",
  "model": "claude-opus-5",
  "source_sha256": "2b97bbcae653c119aed4a24542cedc0d1ee6f8d2c70f630b9a58166737c4227d"
