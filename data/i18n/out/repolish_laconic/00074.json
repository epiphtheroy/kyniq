  "source_sha256": "42ff8588c4ec738d00848693f2b665d0e5e42fa887dcf1eb4c90f370ad881c10"
 },
 {
  "entity_type": "trope",
  "entity_key": "the-woman-as-conduit-between-men",
  "field": "laconic",
  "lang": "ko",
  "text": "삼각관계의 진짜 연애는 두 남자 사이에서 벌어진다.",
