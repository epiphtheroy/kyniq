  "source_sha256": "228dcaee6440565292f9e3f749abdccfd724ea6e7f496a129784d9ec4fb13ad7"
 },
 {
  "entity_type": "trope",
  "entity_key": "the-woman-as-property-in-revolt",
  "field": "laconic",
  "lang": "ko",
  "text": "소유당한 여자가 거부의 팔루스가, 왕좌가, 구호가 된다.",
