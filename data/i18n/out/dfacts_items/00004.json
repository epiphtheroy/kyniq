[
 {
  "entity_type": "director_fact",
  "entity_key": "andrey-zvyagintsev#22",
  "field": "fact",
  "lang": "ko",
  "text": "2022년 러시아가 우크라이나를 전면 침공한 뒤, 즈뱌긴체프는 모스크바로 돌아가지 않았다. 프랑스에 영구 망명한 채 이 전쟁을 '괴물 같은' 재앙이라 규탄한다.",
  "model": "claude-opus-5",
  "source_sha256": "0a7b3c1b593ce1b03b8c8d23838499bf0112e636efe0a92f2d00aa6b07fb8192"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "andrey-zvyagintsev#23",
  "field": "fact",
  "lang": "ko",
  "text": "준비 중인 신작 《Jupiter》는 혼수상태에서 깨어난 그가 다시 카메라 앞에 서는 작품이다. 스페인의 요새 같은 저택에 숨어 사는 무자비한 러시아 올리가르히가 중심에 있다.",
  "model": "claude-opus-5",
  "source_sha256": "de9ce9c903bf229a84dfeb2b4f4f52b1a0e2dd065dc963e94c8a4561f15c56e7"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "andrey-zvyagintsev#24",
  "field": "fact",
  "lang": "ko",
  "text": "아카데미 국제장편영화상 후보에 두 번 오른 포스트소비에트 감독은 몇 되지 않는다. 그는 《리바이어던》과 《러브리스》로 그 일을 해냈다.",
  "model": "claude-opus-5",
  "source_sha256": "c5648cfaf84bb49c8cf940c995684c0095bfeedc53e3086b679025f4cd45a38d"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#1",
  "field": "fact",
  "lang": "ko",
  "text": "이안은 타이완 핑둥에서 태어났다. 아버지 리성은 중국 본토에서 건너온 망명자이자 이안이 다닌 바로 그 고등학교의 위압적인 교장이었고, 어린 이안은 그런 아버지를 무서워하며 자랐다.",
  "model": "claude-opus-5",
  "source_sha256": "1f3b17c587df72f87bc611d11dd438339717dda9323c58e28b43173d0e1b3115"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#2",
  "field": "fact",
  "lang": "ko",
  "text": "학구적인 집안에 그는 큰 수치를 안겼다. 타이완의 혹독한 대학연합고사에 두 번 낙방했고, 크게 실망한 아버지는 몇 달 동안 아들에게 거의 말을 걸지 않았다.",
  "model": "claude-opus-5",
  "source_sha256": "a4f70b5755a8b6afec8b3eae66d8ac1973ef1e4aeda85dd351a696438434a6a0"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#3",
  "field": "fact",
  "lang": "ko",
  "text": "일반 대학 대신 그가 택한 곳은 국립타이완예술전문학교였다. 거기서 무대에 빠졌고, 권위 있는 타이완 전국대학연극경연에서 연기상을 받았다.",
  "model": "claude-opus-5",
  "source_sha256": "93761ca59a6ff5ba7f01d9155e1506ec5a9126316d2454b325dca53d704d2ce9"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#4",
  "field": "fact",
  "lang": "ko",
  "text": "1979년 미국으로 건너가 일리노이대학교 어배너-섐페인 캠퍼스에서 연극을 공부하기 전, 그는 중화민국 해군에서 2년의 의무 복무를 마쳤다.",
  "model": "claude-opus-5",
  "source_sha256": "4d31b85b3eaa24304efe41f8a1b9b96552d9a01059c618c63d21a506a1c50679"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#5",
  "field": "fact",
  "lang": "ko",
  "text": "뉴욕대학교 티시예술대학에서 MFA 과정을 밟던 시절, 그는 동기 스파이크 리의 1982년 졸업작품 《Joe's Bed-Stuy Barbershop: We Cut Heads》에서 조감독으로 일했다.",
  "model": "claude-opus-5",
  "source_sha256": "c22c87424d59f17af0ce0ba9aec39e5ff77018141a67914d7a0bd587ae056492"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#6",
  "field": "fact",
  "lang": "ko",
  "text": "1984년 NYU를 졸업하고 그는 뉴욕 교외에서 6년을 백수 '주부'로 보냈다. 요리와 육아를 도맡았고, 생계는 분자생물학자인 아내 제인 린이 책임졌다. 고된 세월이었다.",
  "model": "claude-opus-5",
  "source_sha256": "9ccb64ff706a3a0d4d3708fa1f92f209a310a6e25517a14991c3dcadbfb3f808"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#7",
  "field": "fact",
  "lang": "ko",
  "text": "집안일에 매인 그 시절이 그를 요리의 달인으로 만들었다. 1994년의 음식 영화 걸작 《음식남녀》는 그 솜씨에 크게 기대고 있으며, 화면에 나오는 정교한 요리 몇 가지는 그가 직접 만들었다.",
  "model": "claude-opus-5",
  "source_sha256": "c58ee0006a83844acd6fbf89d8bda4b324b0bf9d41296abfc46f2611e5773583"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#8",
  "field": "fact",
  "lang": "ko",
  "text": "1990년, 경력이 느닷없이 구조된다. 영화화되지 못한 각본 두 편 《쿵후 선생》과 《결혼 피로연》이 타이완 행정원 신문국이 주최한 시나리오 공모전에서 나란히 1등과 2등을 차지한 것이다.",
  "model": "claude-opus-5",
  "source_sha256": "0c0fa37d96ceabd2fba521dc620d21a64f16ba959fdc5ee30967f4f9fb75a6e3"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#9",
  "field": "fact",
  "lang": "ko",
  "text": "독립 스튜디오 굿 머신의 공동 창립자인 제작자 제임스 샤머스는 이안의 평생 동료가 된다. 두 사람은 거듭 각본을 함께 썼고, 타이완 문화의 결을 서구 관객에게 옮기는 일이 그 작업의 핵심이었다.",
  "model": "claude-opus-5",
  "source_sha256": "8789d10905af37a1ebe4b5879270b7c97b2f3060e3beea43f52024eb686cc175"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#10",
  "field": "fact",
  "lang": "ko",
  "text": "임종을 앞둔 아버지의 축복이 그를 되살렸다. 곧바로 연출한 《브로크백 마운틴》으로 2005년 아카데미 감독상을 받았고, 이 상을 받은 최초의 비백인 감독이 되었다.",
  "model": "claude-opus-5",
  "source_sha256": "a08056ea70a4da04547bc51fe2f729fc6c195a8532cc8913f1340784600f29db"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#11",
  "field": "fact",
  "lang": "ko",
  "text": "2007년의 첩보 스릴러 《색, 계》는 정사 장면이 워낙 노골적이어서 미국에서 NC-17 등급을 받았다. 주연 탕웨이는 중국 국가광파전영전시총국에서 한동안 활동을 봉쇄당했다.",
  "model": "claude-opus-5",
  "source_sha256": "77e75e6a1abab173b215e88a68d9dc1d50dc5882fe96add167765b272aecc2a5"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#12",
  "field": "fact",
  "lang": "ko",
  "text": "2012년의 생존 서사시 《라이프 오브 파이》에 그는 4년을 쏟으며 3D 기술의 한계를 밀어붙였다. 디지털로 만든 벵골호랑이와, 지원자 3,000명 중에서 뽑은 무명의 십대 주연 수라지 샤르마를 이음매 없이 붙여야 했다.",
  "model": "claude-opus-5",
  "source_sha256": "478254ee7e033eb798e858a9f46e13074d3a172913d9175092488afb15492624"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#13",
  "field": "fact",
  "lang": "ko",
  "text": "말년의 그는 초고프레임 촬영에 집착했고, 평가는 갈렸다. 《빌리 린스 롱 하프타임 워크》와 《제미니 맨》을 전례 없는 초당 120프레임, 4K 해상도, 3D로 찍었다.",
  "model": "claude-opus-5",
  "source_sha256": "67ddc033cd499891a6cbcce0d02c046fd197e6c6e74d0fe3481bd792a5adb6e7"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ang-lee#14",
  "field": "fact",
  "lang": "ko",
  "text": "2021년 그는 영국 영화아카데미 최고 영예인 BAFTA 펠로십을 받았다. 시상자는 그의 옛 주연 휴 그랜트. 촬영장에서 자주 진이 빠졌던 배우이자, 감독을 깊이 존경하는 사람이다.",
  "model": "claude-opus-5",
  "source_sha256": "29533f23ecfdb329abb918eaf2ce149a992c70d8bbca72b3236c28d4193f62d2"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#1",
  "field": "fact",
  "lang": "ko",
  "text": "앤서니 루소는 1970년 2월 3일 오하이오주 클리블랜드에서 퍼트리샤와 베이질 루소의 아들로 태어났다. 아버지는 이름난 변호사이자 판사였고, 1979년 클리블랜드 시장 선거에서 데니스 쿠시니치에게 패했다.",
  "model": "claude-opus-5",
  "source_sha256": "a66fac104236c904a0bb3ef2364192feee607b62a5f3044fb36e8a1f8dfb8690"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#2",
  "field": "fact",
  "lang": "ko",
  "text": "결속이 단단한 이탈리아계 미국인 가정에서 자란 그의 일요일은 늘 대가족 만찬이었다. 그리고 그 끝은 어김없이 온 식구가 둘러앉아 고전영화를 보는 시간이었다.",
  "model": "claude-opus-5",
  "source_sha256": "a2dc855bf06a578e8e25da4c5da0fa5eb58a6e08935e04452c37698dfbd27005"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#3",
  "field": "fact",
  "lang": "ko",
  "text": "연기를 공부한 동생 조와 달리, 앤서니는 처음엔 평범한 길을 걸었다. 펜실베이니아대학교에서 경영학과 영문학을 전공했고, 이어 케이스웨스턴리저브대학교 로스쿨에 들어갔다.",
  "model": "claude-opus-5",
  "source_sha256": "1fe30d47c0383b767dafcfba5bac44906501a6dffd29fad729b40992c4c300fe"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#4",
  "field": "fact",
  "lang": "ko",
  "text": "인생 항로가 크게 꺾인 것은 그가 아직 법대생이던 때다. 앤서니와 조는 신용카드 한도를 전부 긁고 학자금 대출까지 끌어와 3만 달러짜리 데뷔작 《Pieces》(1997)를 독립 제작했다.",
  "model": "claude-opus-5",
  "source_sha256": "4ba5f4c70b2bbad8a5b9c6553778cc45b245b9c7bacb80d9037ba1a54cc61a53"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#5",
  "field": "fact",
  "lang": "ko",
  "text": "《Pieces》를 찍을 촬영 허가를 낼 돈이 없었다. 그래서 형제는 밤마다 케이스웨스턴 캠퍼스 도서관에 몰래 들어가 장면을 찍었다.",
  "model": "claude-opus-5",
  "source_sha256": "7ea4b128c91d6c420f22ca26fde9aada267d24cbecef22986ebe408e9e0eaf28"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#6",
  "field": "fact",
  "lang": "ko",
  "text": "거대한 도박은 결실을 맺었다. 《Pieces》가 1997년 슬램댄스 영화제에서 공개됐을 때 객석에 있던 스티븐 소더버그가 눈여겨봤고, 그 자리에서 다음 작품 제작을 제안했다.",
  "model": "claude-opus-5",
  "source_sha256": "f31ce32a08bb3c83a75cc94904c2641856efbcb8faa3dbc3903eeac79f350e55"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#7",
  "field": "fact",
  "lang": "ko",
  "text": "소더버그와 그의 섹션 에이트 파트너 조지 클루니가 나섰다. 두 번째 영화, 클리블랜드를 배경으로 한 강도 코미디 《웰컴 투 콜린우드》(2002)의 투자가 그렇게 성사됐다.",
  "model": "claude-opus-5",
  "source_sha256": "a6c519ceba794c90407849c00deae9d5b3937d779712dc4996c6c262767a14ac"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#8",
  "field": "fact",
  "lang": "ko",
  "text": "소더버그와 클루니라는 특급 후원에도 《웰컴 투 콜린우드》는 흥행에 참패했다. 앤서니는 사실상 빈털터리가 됐고, 텔레비전 연출로 방향을 틀 수밖에 없었다.",
  "model": "claude-opus-5",
  "source_sha256": "58d690c243bd441a03ffd88e0b1d3c66c7f6001aa6c0075f651e54d2bd12ceb0"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#9",
  "field": "fact",
  "lang": "ko",
  "text": "텔레비전에서의 돌파구는 FX 임원 케빈 라일리에게서 왔다. 그가 형제에게 도박 코미디 《Lucky》(2003)의 파일럿 연출을 맡겼고, 이 작품이 감독 론 하워드의 눈에 들었다.",
  "model": "claude-opus-5",
  "source_sha256": "962e36f87cff6dc54837656bc8bcc2b878deff749828ceba7c899b1257332248"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#10",
  "field": "fact",
  "lang": "ko",
  "text": "《Lucky》에 감탄한 하워드는 직접 형제를 불러 《못 말리는 패밀리》(2003) 파일럿을 맡겼다. 앤서니는 이 연출로 프라임타임 에미상 코미디 시리즈 감독상을 받았다.",
  "model": "claude-opus-5",
  "source_sha256": "80392bc994ecab5a441d6020d39733f9112455b54421a60f5dfca5b334ac419e"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#11",
  "field": "fact",
  "lang": "ko",
  "text": "《못 말리는 패밀리》 파일럿에서 형제가 고집한 것은 전편 디지털 비디오, 그것도 핸드헬드 촬영이었다. 다큐멘터리를 흉내 낸 이 방식은 당시 지상파 시트콤으로선 대단히 낯설고 위험한 선택이었다.",
  "model": "claude-opus-5",
  "source_sha256": "6cc30fc00b8d8144b7618c542679e19c4a25d4e67ee7232c266230556267389c"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#12",
  "field": "fact",
  "lang": "ko",
  "text": "NBC 시트콤 《커뮤니티》에서 총괄 프로듀서 겸 연출을 맡은 그는 시즌 2의 저 유명한 페인트볼 에피소드를 함께 지휘했다. 세르조 레오네의 스파게티 웨스턴 화법을 대놓고 패러디한 회차다.",
  "model": "claude-opus-5",
  "source_sha256": "e0d57b496cade60cc9ada1727cd7ac3ac5044cdf31f6da8d8287220ffda6e51b"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#13",
  "field": "fact",
  "lang": "ko",
  "text": "바로 그 능력, 목숨을 건 액션 패러디와 인물 중심 코미디를 《커뮤니티》에서 섞어낸 솜씨가 마블 스튜디오 사장 케빈 파이기를 움직였다. 그는 뜻밖에도 형제를 《캡틴 아메리카: 윈터 솔져》(2014) 감독 후보로 면접했다.",
  "model": "claude-opus-5",
  "source_sha256": "125da87eac98b669445279f4288ea0ed931899ea8b2519de9c8e7eadc996c284"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#14",
  "field": "fact",
  "lang": "ko",
  "text": "마블 일을 따내려고 형제는 두 달을 매달렸다. 30쪽짜리 기획 책자를 만들었고, 《프렌치 커넥션》과 《콘돌》 같은 1970년대 정치 스릴러 장면을 이어 붙인 '립오매틱' 예고편까지 붙였다.",
  "model": "claude-opus-5",
  "source_sha256": "7d89cde91e0f0a8c65bb6fc8c04f3a090b3ff29b9390f715ce03d231986d990d"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#15",
  "field": "fact",
  "lang": "ko",
  "text": "《캡틴 아메리카: 윈터 솔져》의 상당 부분을 앤서니는 고향 클리블랜드에서 찍자고 밀어붙였다. 도심 쇼어웨이 고속도로를 2주간 통제하고 거대한 폭발 총격전을 촬영했다.",
  "model": "claude-opus-5",
  "source_sha256": "9146ad6a8e382be13153ff3bfb6e813ae8fb37067ce060cf0dba8e85b6a6b9db"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#16",
  "field": "fact",
  "lang": "ko",
  "text": "그가 공동 연출한 《어벤져스: 엔드게임》(2019)은 개봉과 함께 역대 최고 흥행작이 됐다. 전 세계 27억 9천만 달러. 블록버스터의 거인이라는 자리가 이때 굳어졌다.",
  "model": "claude-opus-5",
  "source_sha256": "cd122deb5434b858ca997339ac85cf30cfd4a3c533899b51a5489351182ccbbc"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#17",
  "field": "fact",
  "lang": "ko",
  "text": "《어벤져스: 엔드게임》에는 스탠 리의 마지막 카메오가 담겼고, 그 장면도 앤서니의 공동 연출이다. 디지털로 나이를 되돌린 만화의 전설이 1970년대 그 모습 그대로 머슬카를 몰고 군 기지 앞을 지나간다.",
  "model": "claude-opus-5",
  "source_sha256": "c392bf9287545c8357778f56fbc5896c5d1e7fe67040ce50442f4a820d2a04a0"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#18",
  "field": "fact",
  "lang": "ko",
  "text": "할리우드 메이저 스튜디오 체제에서 벗어나려고 그는 2017년 독립 영화·텔레비전 스튜디오 AGBO를 공동 설립했다. 본거지는 로스앤젤레스 다운타운의 널찍한 캠퍼스.",
  "model": "claude-opus-5",
  "source_sha256": "498a3da81c4f1fdfdfdafafd962d515528f758d1bc8eba05be73434b9ec29df6"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#19",
  "field": "fact",
  "lang": "ko",
  "text": "2022년 형제는 AGBO 지분 38%를 일본 게임 대기업 넥슨에 4억 달러를 받고 넘겼다. 독립 제작사의 몸값이 단숨에 11억 달러를 넘어섰다.",
  "model": "claude-opus-5",
  "source_sha256": "63f96701b07f04a26643f9eb22325f751ebb332e570de3ce60c857bbc52f467a"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#20",
  "field": "fact",
  "lang": "ko",
  "text": "뿌리에 대한 자부심이 깊은 그는 러소 브러더스 이탈리아계 미국인 영화 포럼의 회장을 맡고 있다. 이탈리아계 미국인의 경험을 다루는 창작자에게 8,000달러 지원금을 주는 단체다.",
  "model": "claude-opus-5",
  "source_sha256": "fb3b15100aeb5e85237dd0249e8d411d95f6b037cabf78e2d627e850bdccdbcb"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#21",
  "field": "fact",
  "lang": "ko",
  "text": "《체리》(2021)로 그는 클리블랜드라는 뿌리로 돌아갔다. 니코 워커의 반자전 소설이 원작으로, 이라크전 참전 군인이 오피오이드 중독을 감당하려 오하이오의 동네 은행을 터는 이야기다.",
  "model": "claude-opus-5",
  "source_sha256": "1ef4a7461fc0e3e6841c4f67879493414edf44a636fb245685f9c188bab4caec"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "anthony-russo#22",
  "field": "fact",
  "lang": "ko",
  "text": "2024년 7월, 형제는 놀랍게도 마블로 복귀했다. 《어벤져스: 둠스데이》와 《어벤져스: 시크릿 워즈》 연출 계약이었고, 선지급 개런티는 8천만 달러로 알려졌다.",
  "model": "claude-opus-5",
  "source_sha256": "5350317995cda50aee812537fc39b36817fe0a8e5081fef849cfd438d5d6432f"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "ari-aster#1",
  "field": "fact",
  "lang": "ko",
  "text": "아리 애스터는 뉴욕에서 시인 어머니와 재즈 드러머 아버지 사이에 태어났다. 다만 유년의 일부는 영국 체스터에서 보냈고, 이후 가족은 뉴멕시코주 앨버커키로 옮겨 갔다.",
  "model": "claude-opus-5",
  "source_sha256": "7ad6eb2b2e9586c5eb3030115691b0bd7b51a9a471292cbe5a3a34cccd46ceec"
 }
]