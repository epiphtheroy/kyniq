[
 {
  "entity_type": "director_fact",
  "entity_key": "wong-kar-wai#16",
  "field": "fact",
  "lang": "ko",
  "text": "그는 영화를 짝으로 묶어 구상하곤 한다. 《화양연화》와 《2046》은 기억을 파고든 두 편짜리 작업이고, 《중경삼림》과 《타락천사》는 네온이 켜진 홍콩 밤의 양면이다.",
  "model": "claude-opus-5",
  "source_sha256": "21664efa51b6d6979c24772112adb155eebdd96e16cefe48f850e2cabf1b9899"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "wong-kar-wai#17",
  "field": "fact",
  "lang": "ko",
  "text": "《동사서독》을 찍는 동안 예산이 걷잡을 수 없이 불어났다. 겁에 질린 투자자들을 달래려고 왕가위는 자기 영화를 패러디한 슬랩스틱 코미디 《동성서취》를 따로 만들어 내놓았다.",
  "model": "claude-opus-5",
  "source_sha256": "e20ecadd507b5b4d86c0a01f067722be1639cc5648f1bc059d3dac48ed8f4037"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "wong-kar-wai#18",
  "field": "fact",
  "lang": "ko",
  "text": "편집실에서의 완벽주의는 악명이 높다. 《2046》의 마지막 릴이 칸영화제에 도착한 것은 프리미어를 불과 몇 시간 앞둔 시점이었고, 영화제는 예정에 없던 상영 지연을 감수해야 했다.",
  "model": "claude-opus-5",
  "source_sha256": "57e05f110f0cc80d5ca0499b5cdc654af7d1128d40c735656cdf847afc1fd3bd"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "wong-kar-wai#19",
  "field": "fact",
  "lang": "ko",
  "text": "2000년, 프랑스 정부는 동시대 시각예술에 끼친 깊은 영향을 이유로 그에게 레지옹 도뇌르 슈발리에 훈장을 수여했다.",
  "model": "claude-opus-5",
  "source_sha256": "0796f1e6617d268ee9d0294f8f86eee2309b88beb95b3c9429f195932d2c0fb7"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#1",
  "field": "fact",
  "lang": "ko",
  "text": "1989년 3월 20일 몬트리올에서 자비에 돌란타드로스라는 이름으로 태어났다. 아버지는 이집트 콥트계 배우 겸 가수 마뉘엘 타드로스, 어머니는 교사 주느비에브 돌란이다.",
  "model": "claude-opus-5",
  "source_sha256": "b9c83c8eea0233605615f948ffa564573cfbcde96b7a29470da39f654202d9e8"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#2",
  "field": "fact",
  "lang": "ko",
  "text": "아주 어릴 때부터 연기를 시작해 텔레비전 광고에 나왔다. 특히 약국 광고 시리즈에서 아픈 아이를 맡아, 십대가 되기도 전에 퀘벡 관객에게 얼굴을 알렸다.",
  "model": "claude-opus-5",
  "source_sha256": "c150edc9d07dd0601e094aa0301c6166e6e8488c8abfe4ff6f3269d3ed257565"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#3",
  "field": "fact",
  "lang": "ko",
  "text": "아역 시절에는 외화의 프랑스어 더빙에 목소리를 빌려주며 여러 배역을 거쳤다. 훗날 《해리 포터》 시리즈 퀘벡 프랑스어 더빙판에서는 어린 론 위즐리 목소리를 냈다.",
  "model": "claude-opus-5",
  "source_sha256": "4cb2273eb1ae11cbda093f364b1b32a73103ba4c9d6552cd079bdff152d855b0"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#4",
  "field": "fact",
  "lang": "ko",
  "text": "열여섯에 데뷔작 《J'ai tué ma mère》의 시나리오를 썼다. 아역으로 벌어 모은 돈으로 제작비 일부를 댔고, 열아홉에 연출했다. 주연과 제작까지 직접 맡았다.",
  "model": "claude-opus-5",
  "source_sha256": "7834bd94d867780d3e7967252861db9bbdc76824adc45dc199e85fb7e6942139"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#5",
  "field": "fact",
  "lang": "ko",
  "text": "어머니를 향한 십대의 격렬한 애증을 그린 반자전적 데뷔작이었다. 2009년 칸영화제 감독주간에서 첫선을 보이고 상을 셋 받았다. 그는 단숨에 신동이 되었다.",
  "model": "claude-opus-5",
  "source_sha256": "f343cc443f2fed2b5815822e5f4bd14579f4f04b7e9645e256aa61db3c1360d7"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#6",
  "field": "fact",
  "lang": "ko",
  "text": "자기 어머니와의 힘겹고 팽팽한 관계가 영화의 원천이라고 그는 숨기지 않고 말해왔다. 안 도르발이 자주 연기한 어머니들은 작품마다 신화적 중심 인물로 되돌아온다.",
  "model": "claude-opus-5",
  "source_sha256": "43020a216009914dd19954d7eaf04eda8cceffc276e7b94f7f2b5d62011c4df9"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#7",
  "field": "fact",
  "lang": "ko",
  "text": "게이임을 경력 초반에 일찌감치 공개했다. 퀴어의 욕망을 따로 떼어낸 특별한 소재로 다루지 않고, 영화가 놓인 평범한 감정의 날씨로 삼는다.",
  "model": "claude-opus-5",
  "source_sha256": "2796eaee3b8d83124ab0504ab658ea31efacd3d79221a83bb3d1de8cd63b7786"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#8",
  "field": "fact",
  "lang": "ko",
  "text": "의상을 직접 디자인하거나 끝까지 챙기고, 편집도 제 손으로 하는 경우가 많다. 거의 전권을 쥔 작가주의(auteurism)적 통제인데, 본인은 성미가 급하고 원하는 그림이 지나치게 구체적인 탓이라고 설명한다.",
  "model": "claude-opus-5",
  "source_sha256": "df93b1be880324dc34763026f2b7f0f2b242c19b12a36d941dbcfb379d083db3"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#9",
  "field": "fact",
  "lang": "ko",
  "text": "팝 음악에 사로잡혀 있다. 달리다의 'Bang Bang'부터 오아시스의 'Wonderwall'까지, 노래에 맞춘 길고 오페라 같은 뮤직비디오풍 시퀀스를 영화 안에 지어 넣는다.",
  "model": "claude-opus-5",
  "source_sha256": "7550f3cec3ecb679618b50f75c18abe7a95db6f7e4544d5bfbbde96e5ca8f2c9"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#10",
  "field": "fact",
  "lang": "ko",
  "text": "2015년 아델의 'Hello' 뮤직비디오를 퀘벡 시골에서 찍었다. 유튜브에서 10억 조회를 가장 빠르게 넘긴 영상 축에 든다.",
  "model": "claude-opus-5",
  "source_sha256": "dc0292279b07a52dc649324c2a7d6fd9d20588831bf8672b1a61f5260c1d7739"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#11",
  "field": "fact",
  "lang": "ko",
  "text": "《마미》의 화면은 대부분 1대 1 정사각형이다. 그러다 중반, 황홀에 젖은 인물이 두 손으로 화면 양옆을 밀어젖힌다. 칸의 관객이 탄성을 터뜨린 순간이다.",
  "model": "claude-opus-5",
  "source_sha256": "73d2fe284d429978b81b2973eedf314fc7411932980e1419740a27080023b643"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#12",
  "field": "fact",
  "lang": "ko",
  "text": "영어권 할리우드 데뷔작 《The Death and Life of John F. Donovan》은 키트 해링턴과 나탈리 포트먼을 앞세우고도 재촬영에 시달렸다. 제시카 차스테인의 연기는 완성본에서 통째로 잘려 나갔다.",
  "model": "claude-opus-5",
  "source_sha256": "6fe708b69111eff7d5b646d8fa1e4e7c71a663d94f44597802aa653569ac3974"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#13",
  "field": "fact",
  "lang": "ko",
  "text": "제인 캠피언과 왕가위를 향한 깊은 존경을 여러 차례 밝혔다. 《화양연화》의 느린 화면, 그리움이 배어 있는 결이 그의 스타일에 그대로 울린다.",
  "model": "claude-opus-5",
  "source_sha256": "1ee15ff94ec382eee6e8e3f1df1f4f1eb20e4a1b90160968d54a55847e6b292a"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#14",
  "field": "fact",
  "lang": "ko",
  "text": "배우 안 도르발, 앙투안 올리비에 필롱과는 오래 호흡을 맞춰왔다. 여러 편을 함께 도는 상설 극단처럼 배우들을 다룬다.",
  "model": "claude-opus-5",
  "source_sha256": "0a6e82a4a82f9b6eb2f6c9069929cb92fc094fcd9f78b463401327f06a7eaaf9"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#15",
  "field": "fact",
  "lang": "ko",
  "text": "온라인에서 비평가와 기자들을 상대로 공개 설전을 벌였다. 《단지 세상의 끝》에 혹평을 실은 잡지를 대놓고 성토한 일이 특히 유명하다. 자기 작업 앞에서 얇은 피부를 드러내는 열정가로 통한다.",
  "model": "claude-opus-5",
  "source_sha256": "01fe1e494a6bf7ae11a9b3f57c3c26debbec894cc9f9afee40659e351c61f73c"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#16",
  "field": "fact",
  "lang": "ko",
  "text": "2018년에는 퀘벡 주정부의 표창을 비롯해 여러 훈격을 받았다. 퀘벡 스타 시스템의 붙박이이며, 고향에서 그의 명성은 웬만한 지역 정치인을 넘어선다.",
  "model": "claude-opus-5",
  "source_sha256": "18fba1d3f09fa08b88247aea760a8f5b99c3aad70dc1c1cbc22bfed37e44f196"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#17",
  "field": "fact",
  "lang": "ko",
  "text": "텔레비전으로 방향을 튼 것은 2022년이다. 프랑스어 미니시리즈 《La nuit où Laurier Gaudreault s'est réveillé》로 희곡을 각색하며, 또 한 번 묻혀 있던 가족의 상처를 파냈다.",
  "model": "claude-opus-5",
  "source_sha256": "9c3ce3df5d4bf9a2c5f31d53ec2886b6f16e6cba00eab71f43ba6b6cf4416179"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#18",
  "field": "fact",
  "lang": "ko",
  "text": "2023년, 그는 연출에서 물러나겠다고 알렸다. 영화에 대한 허기가 사라졌고 업계에도 관객의 무관심에도 환멸을 느낀다고 인터뷰에서 말했다.",
  "model": "claude-opus-5",
  "source_sha256": "6ce9ebe5dabd48b782db86cf4599e4b769fa08f3f8351a8e758c2b2a8b5ae873"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#19",
  "field": "fact",
  "lang": "ko",
  "text": "제작사 이름은 아버지 마뉘엘에게서 따온 Sons of Manual이다. 아버지의 부재를 그토록 자주 극화해온 감독치고는 유별나게 효성스러운 작명.",
  "model": "claude-opus-5",
  "source_sha256": "8621be63b9b01f96ce287bf9b86f724b2c499a4748b7027aa09565a971555076"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#20",
  "field": "fact",
  "lang": "ko",
  "text": "《로렌스 애니웨이즈》는 한 남자의 성전환을 십 년에 걸쳐 좇는 세 시간 가까운 대작이다. 그때 그는 갓 스물둘이었다. 2012년 칸 주목할 만한 시선에서 비평가들을 놀라게 한 것은 그 배포였다.",
  "model": "claude-opus-5",
  "source_sha256": "922843cc62c97d74a8bf847c5652a0ae6af9e13c5cf3eeebd951698b140ccea8"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#21",
  "field": "fact",
  "lang": "ko",
  "text": "비, 슬로모션, 느닷없이 터지는 채도 높은 색. 그의 영화는 그런 것들로 흠뻑 젖어 있다. 스타일리스트일 뿐이라는 비난에 맞서 이 최대주의적 낭만을 그는 계속 옹호해왔다.",
  "model": "claude-opus-5",
  "source_sha256": "902e41573344ac1771d23489af5ed62991283ef4773387316150098caf1acbcd"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#22",
  "field": "fact",
  "lang": "ko",
  "text": "스스로를 무엇보다 작가이자 이야기꾼으로 여긴다고 말한 적이 있다. 그의 시나리오는 길고 연극적인 독백으로 짜여, 인물의 입에서 감정이 격류처럼 쏟아진다.",
  "model": "claude-opus-5",
  "source_sha256": "a1b8865116c6c1aeb2572bbd6e2ddbad724ebaf1fb28acb61723c49806ec5ea4"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#23",
  "field": "fact",
  "lang": "ko",
  "text": "국제적 찬사를 받고도 퀘벡과 프랑스어에 뿌리를 둔 채 남았다. 영어권 스튜디오들이 손을 내밀었지만 할리우드에 완전히 녹아들지는 않았다.",
  "model": "claude-opus-5",
  "source_sha256": "ad972e5947a3fa48e28e0d53740cd6e54a38dd0f1b1987e0fa18c809007ff277"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "xavier-dolan#24",
  "field": "fact",
  "lang": "ko",
  "text": "스물다섯 무렵 이미 장편 다섯 편을 연출했고 칸에서 여러 차례 상을 받았다. 영화제 역사를 통틀어 가장 많은 상을 단 젊은 작가 중 하나다.",
  "model": "claude-opus-5",
  "source_sha256": "e43fa1ba91eda2ac993911ada1a8a5ab56a2075cd1170e2a5addf8bc5ff46c9f"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#1",
  "field": "fact",
  "lang": "ko",
  "text": "1903년 12월 12일 도쿄 후카가와에서 태어났다. 상인들의 동네였고, 1923년 간토대지진으로 잿더미가 된 곳이다.",
  "model": "claude-opus-5",
  "source_sha256": "23e64e6e0039fb7dd3e8311ce112ea24af25928fd14ff447a36df670403d498c"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#2",
  "field": "fact",
  "lang": "ko",
  "text": "비료상을 하던 아버지는 오즈가 아홉 살 때 가족을 미에현 마쓰사카로 내려보냈다. 정작 아버지는 도쿄에 남아 일했다. 그래서 오즈의 유년에는 아버지가 거의 없었다.",
  "model": "claude-opus-5",
  "source_sha256": "a8c197faec59343cc1690601025b58f53e480eaf09db0ac0a6f76d3bd8bc63fa"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#3",
  "field": "fact",
  "lang": "ko",
  "text": "마쓰사카의 우지야마다 중학교에서 그는 성적이 나쁘고 말썽으로 이름난 학생이었다. 아래 학년 남학생에게 연애편지를 보냈다가 기숙사에서 쫓겨났다.",
  "model": "claude-opus-5",
  "source_sha256": "92f9253ed031017c5893a0d01c0261de9eb49fcccfc739062723c6076c03b9e1"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#4",
  "field": "fact",
  "lang": "ko",
  "text": "십대의 그를 사로잡은 것은 영화였다. 수업을 빼먹고 극장에 앉아 미국 영화를, 특히 우상이던 렉스 잉그램의 작품을 봤다.",
  "model": "claude-opus-5",
  "source_sha256": "c2fe17fd69dabb44f8b5e53326dd5aabbbe7b2b013381cfabde7b37ee806b08a"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#5",
  "field": "fact",
  "lang": "ko",
  "text": "상급학교 입시에 떨어진 뒤 미에현 산골 마을에서 잠시 대용교원으로 일했다. 영화 일은 그 다음이었다.",
  "model": "claude-opus-5",
  "source_sha256": "fc82c169e78a1c2be39a2427eaf9a50d0fc23bda4a7f4ccb728a1036dcb9bf39"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#6",
  "field": "fact",
  "lang": "ko",
  "text": "1923년 쇼치쿠 가마타 촬영소에 촬영조수로 들어갔다. 집안의 연줄과 본인의 막무가내 집념이 반반쯤 작용했다고 전한다.",
  "model": "claude-opus-5",
  "source_sha256": "e246068b0ff284c7369bb504b0271194e6f0df1212d27a2bd0ff39173d99374b"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#7",
  "field": "fact",
  "lang": "ko",
  "text": "중일전쟁 때 중국 전선에 배치돼 이 년 가까이 복무했다. 독가스 작전에 가담했다고 전해지지만, 그 시절 이야기를 그는 좀처럼 입에 올리지 않았다.",
  "model": "claude-opus-5",
  "source_sha256": "a54f576c9a83a993bd372ef1cddc5dcd9a65ebdc7807c65239ecc198537dd265"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#8",
  "field": "fact",
  "lang": "ko",
  "text": "2차 대전 중에는 인도 독립운동 지도자 찬드라 보스를 다룬 선전영화를 만들라는 명을 받고 싱가포르로 갔다. 정작 시간을 쏟은 일은 압수된 미국 영화를 보는 것이었다. 《시민 케인》과 디즈니의 《판타지아》도 그 안에 있었다.",
  "model": "claude-opus-5",
  "source_sha256": "fce1fa64065cd3da7d7cf02916eb7618a90e8716b7ddfcbc3f724ebb702eee1c"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#9",
  "field": "fact",
  "lang": "ko",
  "text": "카메라는 거의 언제나 낮았다. 다다미에 앉은 사람의 눈높이쯤. '다다미 쇼트'로 불리는 이 앵글을 위해 그는 규격을 지정해 낮은 삼각대를 따로 만들어 썼다.",
  "model": "claude-opus-5",
  "source_sha256": "79c569625614eb677f7bd0fdcec8e186af8295bfab65ad18b0c57cc57a08a88b"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#10",
  "field": "fact",
  "lang": "ko",
  "text": "원숙기에 접어들자 카메라 이동도, 달리도, 디졸브와 페이드도 사실상 금지했다. 멈춰 선 화면과 화면을 곧장 잘라 붙였다. 할리우드 문법을 정면으로 거스른 것이다.",
  "model": "claude-opus-5",
  "source_sha256": "f9606bd8465b5e61e7940ce7842a5573000f47769ff0ef5dae35a08ad83e2940"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#11",
  "field": "fact",
  "lang": "ko",
  "text": "배우들은 대사를 할 때 렌즈를 거의 똑바로 바라봤다. 다른 감독이라면 예외 없이 지켰을 180도 법칙을 그는 태연히 깼다.",
  "model": "claude-opus-5",
  "source_sha256": "8177aaba90b5f64b0cfd187d298dd29b8527bf58dc808b7164b6000738962094"
 },
 {
  "entity_type": "director_fact",
  "entity_key": "yasujiro-ozu#12",
  "field": "fact",
  "lang": "ko",
  "text": "장면과 장면 사이에는 고요한 '필로 쇼트'가 끼어든다. 빈 복도, 널린 빨래, 굴뚝, 풍경. 사색적인 그의 스타일을 알아보게 하는 이음매가 되었다.",
  "model": "claude-opus-5",
  "source_sha256": "026715050c3a405c5bacf606b2f9cfcc0033149ea7808f84c57ed17cd536d2e5"
 }
]