{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "incremental": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "/tmp/ask-shim.d.ts",
    "lib/ask/queryUnderstanding.ts",
    "lib/ask/rerank.ts",
    "lib/ask/diversify.ts",
    "lib/ask/prompt.ts",
    "lib/providers/openai.ts",
    "lib/providers/types.ts"
  ]
}
